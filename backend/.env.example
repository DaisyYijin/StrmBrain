# ===== STRMhub 环境变量配置 =====
# 复制此文件为 .env 并修改为你的配置

# 服务器
HOST=0.0.0.0
PORT=1024

# JWT 密钥（留空则首次启动自动生成并持久化到 data/.secret_key）
SECRET_KEY=

# 登录验证（默认开启，设为 false 可关闭）
AUTH_ENABLED=true

# 管理员账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# CORS 允许的源（逗号分隔，留空则不启用 CORS，前后端同源无需配置）
# 例：http://localhost:3000,http://192.168.1.100:8080
CORS_ORIGINS=

# 版本号
VERSION=0.1.0
