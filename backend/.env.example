# ===== STRMhub 环境变量配置 =====
# 复制此文件为 .env 并修改为你的配置

# 服务器
HOST=0.0.0.0
PORT=6060

# JWT 密钥（留空则首次启动自动生成并持久化到 data/.secret_key）
SECRET_KEY=

# 登录验证（默认开启，设为 false 可关闭）
AUTH_ENABLED=true

# 管理员账号（已废弃）
# 从 v1.1 起不再使用环境变量管理账号，首次部署时在登录页注册账号密码，
# 账号保存在 config/local_account.json，升级/重启不丢失。
# 以下两项仅保留占位，不再参与登录认证。
ADMIN_USERNAME=
ADMIN_PASSWORD=

# CORS 允许的源（逗号分隔，留空则不启用 CORS，前后端同源无需配置）
# 例：http://localhost:3000,http://192.168.1.100:8080
CORS_ORIGINS=

# 版本号
VERSION=0.1.0
